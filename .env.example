# ─────────────────────────────────────────────────────────────────────────────
# Elastic Observability Lab — Example Environment File
#
# Copy this file to .env and customise:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is in .gitignore.
# This file (.env.example) is safe to commit; it contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Elastic Stack Version ────────────────────────────────────────────────────
# Use the same version for Elasticsearch and Kibana
ELASTIC_VERSION=8.19.21

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200

# Credentials (leave empty if xpack.security.enabled=false — local dev default)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── Kibana ───────────────────────────────────────────────────────────────────
KIBANA_PORT=5601

# Kibana system user password (leave empty for local dev with security disabled)
KIBANA_SYSTEM_PASSWORD=

# ── OpenTelemetry Collector ───────────────────────────────────────────────────
OTEL_COLLECTOR_VERSION=0.160.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ── FastAPI Application ───────────────────────────────────────────────────────
APP_PORT=8000
OTEL_SERVICE_NAME=elastic-observability-demo

# OTel exporter endpoint — points to the OTel Collector inside Docker network
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Failure Simulation ────────────────────────────────────────────────────────
# Set to "true" to enable artificial 2–5 second latency on /api/orders
# Set to "false" for normal operation (~50–200ms)
SIMULATE_LATENCY=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
