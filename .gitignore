# ─────────────────────────────────────────────────────────────────────────────
# Elastic Observability Lab — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.key
*.pem
*.crt
*.pfx
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Elasticsearch & Kibana Data ───────────────────────────────────────────────
# Never commit generated data volumes
data/
esdata/
elasticsearch-data/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't commit generated docker override files with local secrets
docker-compose.override.yml

# ── Pytest & Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
